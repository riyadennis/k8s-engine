# Docker registry credentials for deploy-minikube.sh
# Fill in and then `source .env` before running the script.

DOCKER_USERNAME=your-docker-username
DOCKER_PASSWORD=your-docker-password-or-token

# Optional: registry URL (leave empty for Docker Hub)
# Example: https://index.docker.io/v1/  (Docker Hub)
#          https://gcr.io                (GCR)
#          https://registry.gitlab.com   (GitLab)
DOCKER_REGISTRY=

